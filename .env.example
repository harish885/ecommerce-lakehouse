# ─────────────────────────────────────────────
# Azure E-Commerce Lakehouse — environment variables
# ─────────────────────────────────────────────
#
# Copy this file to `.env` and fill in the values for your own Azure
# subscription if you want to override the defaults baked into
# `config/config.yaml`.

# Azure Data Lake Storage Gen2
AZURE_STORAGE_ACCOUNT_NAME=stecomlakehousehb01
AZURE_FILE_SYSTEM=olist-lakehouse

# Azure tenancy (only required if not relying on `az login`)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Local paths (used by the local `Storage` backend)
LOCAL_RAW_PATH=data/raw
LOCAL_BRONZE_PATH=data/bronze
LOCAL_SILVER_PATH=data/silver
LOCAL_GOLD_PATH=data/gold
LOCAL_REJECTED_PATH=data/rejected
LOCAL_LOGS_PATH=logs
